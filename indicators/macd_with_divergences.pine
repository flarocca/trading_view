//@vehiston=6
indicator("MACD with Divergences", shorttitle="MACD+Div", precision=1, max_bars_back=500)

// ============================================================
// Inputs: MACD
// ============================================================
fastLen = input.int(12, "Fast Length",   group="MACD")
slowLen = input.int(26, "Slow Length",   group="MACD")
sigLen  = input.int(9,  "Signal Length", group="MACD")
src     = input.source(close, "Source",  group="MACD")
maType  = input.string("EMA", "MA Type", options=["EMA", "SMA"], group="MACD", display=display.none)

// ============================================================
// Inputs: Divergence detection
// ============================================================
pivotLeft      = input.int(4,  "Pivot Left Bars",              minval=1, group="Divergence", display=display.none)
pivotRight     = input.int(4,  "Pivot Right Bars",             minval=1, group="Divergence", display=display.none)
tentativeRight = input.int(1,  "Tentative Pivot Right Bars",   minval=1, group="Divergence")
rangeMin       = input.int(5,  "Min Bars Between Pairs",       minval=1, group="Divergence", display=display.none)
rangeMax       = input.int(40, "Max Bars Between Pairs",       minval=5, group="Divergence", display=display.none)
matchTolerance = input.int(6,  "Price/MACD-hist Pivot Match Tolerance (bars)",
                                                                minval=0, group="Divergence")

showRegBull = input.bool(true, "Regular Bullish (price LL / MACD-hist HL)", group="Divergence Types")
showRegBear = input.bool(true, "Regular Bearish (price HH / MACD-hist LH)", group="Divergence Types")
showHidBull = input.bool(true, "Hidden Bullish  (price HL / MACD-hist LL)", group="Divergence Types")
showHidBear = input.bool(true, "Hidden Bearish  (price LH / MACD-hist HH)", group="Divergence Types")

// ============================================================
// Inputs: Divergence quality filter
//
// A divergence is a disagreement, so it qualifies when EITHER series moves
// decisively while the other contradicts it — the two thresholds are OR'd, not
// AND'd. Measured over 1,134 symbol-years of daily history, exactly one leg
// carries the move in 89.6% of real cases; requiring both would discard roughly
// nine of every ten genuine setups.
//
// "Decisive" is measured in units of each series' own recent variability, never
// in percent or raw points. Percent is meaningless on a bounded oscillator (a
// 0.2-point MACD-hist move is 1.33% at MACD-hist 15 and 0.29% at MACD-hist 70, though visually
// identical) and raw points need re-tuning whenever volatility changes.
//
// Defaults are top-25% selectivity, calibrated jointly — each threshold sits at
// the same percentile of its own series' distribution. Do not tune one in
// isolation; move both together or the detector silently favours price-led
// divergences. See docs/divergence_parity.md in the trading_bot repo.
// ============================================================
minPriceAtrMult = input.float(1.24, "Min Price Move (× ATR)",     minval=0.0, step=0.01, group="Divergence Quality")
minHistSigmaMult = input.float(1.48, "Min MACD-hist Move (× hist stdev)", minval=0.0, step=0.01, group="Divergence Quality")
atrLen          = input.int(14, "ATR Length",                     minval=1,  group="Divergence Quality")
histStdLen      = input.int(50, "MACD-hist Stdev Length",          minval=10, group="Divergence Quality")
// No absolute floor: the histogram is unbounded and its scale tracks price,
// so there is no fixed number that means "quiet" across symbols.
histStdFloor    = input.float(0.0, "MACD-hist Stdev Floor",         minval=0.0, step=0.01, group="Divergence Quality")

// ============================================================
// Inputs: Path integrity
// An interior peak/trough between A and B only invalidates the
// divergence if it exceeds the reference pivot by more than the
// path threshold. Small overshoots are treated as noise.
// ============================================================
pathPriceAtrMult = input.float(0.3, "Path Invalidation — Price Excess (× ATR)", minval=0.0, step=0.1, group="Path Integrity")
pathHistSigmaMult = input.float(0.33, "Path Invalidation — MACD-hist Excess (× hist stdev)", minval=0.0, step=0.01, group="Path Integrity")

// ============================================================
// Inputs: Debug
// ============================================================
showPivots = input.bool(false, "Show All Pivots (debug)", group="Debug")

// ============================================================
// MACD + signal + histogram
//
// Divergence is measured on the HISTOGRAM, matching the bot's deployed
// `macd_divergence` subscriptions. The histogram and the MACD line are
// different signals with different statistics — the histogram produces ~2.1x
// the opposed pivot pairs — so their thresholds are not interchangeable.
// ============================================================
fastMA     = maType == "EMA" ? ta.ema(src,  fastLen) : ta.sma(src,  fastLen)
slowMA     = maType == "EMA" ? ta.ema(src,  slowLen) : ta.sma(src,  slowLen)
macd       = fastMA - slowMA
signalLine = maType == "EMA" ? ta.ema(macd, sigLen)  : ta.sma(macd, sigLen)
hist       = macd - signalLine

upColor   = hist > nz(hist[1]) ? color.new(color.green, 0) : color.new(color.green, 50)
downColor = hist < nz(hist[1]) ? color.new(color.red,   0) : color.new(color.red,   50)
histColor = hist >= 0 ? upColor : downColor

plot(macd,       "MACD",      color=color.new(color.blue,   0))
plot(signalLine, "Signal",    color=color.new(color.orange, 0))
plot(hist,       "Histogram", color=histColor, style=plot.style_columns)
hline(0, "Zero", color=color.new(color.gray, 50))

atrVal = ta.atr(atrLen)
// Scale for "what counts as a normal MACD-hist move" in the current regime. The floor
// stops a becalmed series driving the deviation toward zero, which would make
// every wiggle read as many sigma.
histStd = math.max(ta.stdev(hist, histStdLen), histStdFloor)
histExcess = histStd * pathHistSigmaMult

// ============================================================
// CONFIRMED pivot detection
// ============================================================
phPriceRaw = ta.pivothigh(high, pivotLeft, pivotRight)
plPriceRaw = ta.pivotlow(low,   pivotLeft, pivotRight)
phHistRaw   = ta.pivothigh(hist,  pivotLeft, pivotRight)
plHistRaw   = ta.pivotlow(hist,   pivotLeft, pivotRight)

newPricePHBar = not na(phPriceRaw) ? bar_index - pivotRight : na
newPricePHVal = not na(phPriceRaw) ? high[pivotRight]       : na
newPricePLBar = not na(plPriceRaw) ? bar_index - pivotRight : na
newPricePLVal = not na(plPriceRaw) ? low[pivotRight]        : na
newHistPHBar   = not na(phHistRaw)   ? bar_index - pivotRight : na
newHistPHVal   = not na(phHistRaw)   ? hist[pivotRight]        : na
newHistPLBar   = not na(plHistRaw)   ? bar_index - pivotRight : na
newHistPLVal   = not na(plHistRaw)   ? hist[pivotRight]        : na

// ============================================================
// TENTATIVE pivot detection
// ============================================================
tPhPriceRaw = ta.pivothigh(high, pivotLeft, tentativeRight)
tPlPriceRaw = ta.pivotlow(low,   pivotLeft, tentativeRight)
tPhHistRaw   = ta.pivothigh(hist,  pivotLeft, tentativeRight)
tPlHistRaw   = ta.pivotlow(hist,   pivotLeft, tentativeRight)

tNewPricePHBar = not na(tPhPriceRaw) ? bar_index - tentativeRight : na
tNewPricePHVal = not na(tPhPriceRaw) ? high[tentativeRight]       : na
tNewPricePLBar = not na(tPlPriceRaw) ? bar_index - tentativeRight : na
tNewPricePLVal = not na(tPlPriceRaw) ? low[tentativeRight]        : na
tNewHistPHBar   = not na(tPhHistRaw)   ? bar_index - tentativeRight : na
tNewHistPHVal   = not na(tPhHistRaw)   ? hist[tentativeRight]        : na
tNewHistPLBar   = not na(tPlHistRaw)   ? bar_index - tentativeRight : na
tNewHistPLVal   = not na(tPlHistRaw)   ? hist[tentativeRight]        : na

// ============================================================
// Debug plotshapes
// ============================================================
plotshape(showPivots and not na(newPricePHBar) ? hist[pivotRight] : na, "Price PH (debug)",
          style=shape.xcross, location=location.absolute,
          color=color.new(color.red,   0), size=size.tiny, offset=-pivotRight)
plotshape(showPivots and not na(newPricePLBar) ? hist[pivotRight] : na, "Price PL (debug)",
          style=shape.xcross, location=location.absolute,
          color=color.new(color.green, 0), size=size.tiny, offset=-pivotRight)
plotshape(showPivots and not na(newHistPHBar)   ? hist[pivotRight] : na, "MACD-hist PH (debug)",
          style=shape.circle, location=location.absolute,
          color=color.new(color.red,   0), size=size.tiny, offset=-pivotRight)
plotshape(showPivots and not na(newHistPLBar)   ? hist[pivotRight] : na, "MACD-hist PL (debug)",
          style=shape.circle, location=location.absolute,
          color=color.new(color.green, 0), size=size.tiny, offset=-pivotRight)

plotshape(showPivots and not na(tNewPricePHBar) ? hist[tentativeRight] : na, "Tent Price PH (debug)",
          style=shape.triangledown, location=location.absolute,
          color=color.new(color.red,   0), size=size.tiny, offset=-tentativeRight)
plotshape(showPivots and not na(tNewPricePLBar) ? hist[tentativeRight] : na, "Tent Price PL (debug)",
          style=shape.triangleup,   location=location.absolute,
          color=color.new(color.green, 0), size=size.tiny, offset=-tentativeRight)
plotshape(showPivots and not na(tNewHistPHBar)   ? hist[tentativeRight] : na, "Tent MACD-hist PH (debug)",
          style=shape.diamond, location=location.absolute,
          color=color.new(color.red,   0), size=size.tiny, offset=-tentativeRight)
plotshape(showPivots and not na(tNewHistPLBar)   ? hist[tentativeRight] : na, "Tent MACD-hist PL (debug)",
          style=shape.diamond, location=location.absolute,
          color=color.new(color.green, 0), size=size.tiny, offset=-tentativeRight)

// ============================================================
// STATE: Confirmed waiting slots
// ============================================================
var int   waitPricePHBar = na
var float waitPricePHVal = na
var int   waitHistPHBar   = na
var float waitHistPHVal   = na

var int   waitPricePLBar = na
var float waitPricePLVal = na
var int   waitHistPLBar   = na
var float waitHistPLVal   = na

// STATE: Last two confirmed pairs
var int   currPHPriceBar = na
var float currPHPriceVal = na
var int   currPHHistBar   = na
var float currPHHistVal   = na
var int   prevPHPriceBar = na
var float prevPHPriceVal = na
var int   prevPHHistBar   = na
var float prevPHHistVal   = na

var int   currPLPriceBar = na
var float currPLPriceVal = na
var int   currPLHistBar   = na
var float currPLHistVal   = na
var int   prevPLPriceBar = na
var float prevPLPriceVal = na
var int   prevPLHistBar   = na
var float prevPLHistVal   = na

// STATE: Tentative waiting slots
var int   tWaitPricePHBar = na
var float tWaitPricePHVal = na
var int   tWaitHistPHBar   = na
var float tWaitHistPHVal   = na

var int   tWaitPricePLBar = na
var float tWaitPricePLVal = na
var int   tWaitHistPLBar   = na
var float tWaitHistPLVal   = na

// STATE: Active tentative line references
var line tPHLineHist   = na
var line tPHLinePrice = na
var line tPLLineHist   = na
var line tPLLinePrice = na

// Divergence flags (reset each bar)
regBull  = false
regBear  = false
hidBull  = false
hidBear  = false
tRegBull = false
tRegBear = false
tHidBull = false
tHidBear = false

// ============================================================
// CONFIRMED HIGHS
// ============================================================
pairedH   = false
pairedHPB = 0
pairedHPV = 0.0
pairedHRB = 0
pairedHRV = 0.0

if not na(newPricePHBar) and not na(newHistPHBar)
    pairedH := true
    pairedHPB := newPricePHBar
    pairedHPV := newPricePHVal
    pairedHRB := newHistPHBar
    pairedHRV := newHistPHVal

if not pairedH and not na(newPricePHBar) and not na(waitHistPHBar) and math.abs(newPricePHBar - waitHistPHBar) <= matchTolerance
    pairedH := true
    pairedHPB := newPricePHBar
    pairedHPV := newPricePHVal
    pairedHRB := waitHistPHBar
    pairedHRV := waitHistPHVal

if not pairedH and not na(newHistPHBar) and not na(waitPricePHBar) and math.abs(newHistPHBar - waitPricePHBar) <= matchTolerance
    pairedH := true
    pairedHPB := waitPricePHBar
    pairedHPV := waitPricePHVal
    pairedHRB := newHistPHBar
    pairedHRV := newHistPHVal

if pairedH
    if not na(tPHLineHist)
        line.delete(tPHLineHist)
        tPHLineHist := na
    if not na(tPHLinePrice)
        line.delete(tPHLinePrice)
        tPHLinePrice := na
    tWaitPricePHBar := na
    tWaitPricePHVal := na
    tWaitHistPHBar   := na
    tWaitHistPHVal   := na
    prevPHPriceBar := currPHPriceBar
    prevPHPriceVal := currPHPriceVal
    prevPHHistBar   := currPHHistBar
    prevPHHistVal   := currPHHistVal
    currPHPriceBar := pairedHPB
    currPHPriceVal := pairedHPV
    currPHHistBar   := pairedHRB
    currPHHistVal   := pairedHRV
    waitPricePHBar := na
    waitPricePHVal := na
    waitHistPHBar   := na
    waitHistPHVal   := na
    if not na(prevPHPriceVal)
        gapH = currPHPriceBar - prevPHPriceBar
        if gapH >= rangeMin and gapH <= rangeMax
            priceDeltaH = math.abs(currPHPriceVal - prevPHPriceVal)
            histDeltaH   = math.abs(currPHHistVal   - prevPHHistVal)
            qualityOkH  = priceDeltaH >= atrVal * minPriceAtrMult or histDeltaH >= histStd * minHistSigmaMult
            // Path integrity: static loop with break for correct buffer allocation
            float priceMaxInterior = na
            float histMaxInterior   = na
            if currPHPriceBar - prevPHPriceBar > 1
                for i = 1 to 500
                    int checkBar = prevPHPriceBar + i
                    if checkBar >= currPHPriceBar
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float pv = high[offset]
                        if na(priceMaxInterior) or pv > priceMaxInterior
                            priceMaxInterior := pv
            if currPHHistBar - prevPHHistBar > 1
                for i = 1 to 500
                    int checkBar = prevPHHistBar + i
                    if checkBar >= currPHHistBar
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float rv = hist[offset]
                        if na(histMaxInterior) or rv > histMaxInterior
                            histMaxInterior := rv
            priceExcess = atrVal * pathPriceAtrMult
            // Regular bearish: reference HH = currPH price, reference LH = prevPH hist
            if currPHPriceVal > prevPHPriceVal and currPHHistVal < prevPHHistVal and qualityOkH
                pathOkRegBearH = (na(priceMaxInterior) or priceMaxInterior <= currPHPriceVal + priceExcess) and (na(histMaxInterior) or histMaxInterior <= prevPHHistVal + histExcess)
                if pathOkRegBearH
                    regBear := true
                    if showRegBear
                        line.new(prevPHHistBar, prevPHHistVal, currPHHistBar, currPHHistVal,
                                 color=color.red, width=2)
                        line.new(prevPHPriceBar, prevPHPriceVal, currPHPriceBar, currPHPriceVal,
                                 color=color.red, width=2, force_overlay=true)
            // Hidden bearish: reference LH = currPH price, reference HH = currPH hist
            if currPHPriceVal < prevPHPriceVal and currPHHistVal > prevPHHistVal and qualityOkH
                pathOkHidBearH = (na(priceMaxInterior) or priceMaxInterior <= prevPHPriceVal + priceExcess) and (na(histMaxInterior) or histMaxInterior <= currPHHistVal + histExcess)
                if pathOkHidBearH
                    hidBear := true
                    if showHidBear
                        line.new(prevPHHistBar, prevPHHistVal, currPHHistBar, currPHHistVal,
                                 color=color.orange, width=2)
                        line.new(prevPHPriceBar, prevPHPriceVal, currPHPriceBar, currPHPriceVal,
                                 color=color.orange, width=2, force_overlay=true)
else
    if not na(newPricePHBar)
        waitPricePHBar := newPricePHBar
        waitPricePHVal := newPricePHVal
    if not na(newHistPHBar)
        waitHistPHBar := newHistPHBar
        waitHistPHVal := newHistPHVal

// ============================================================
// CONFIRMED LOWS
// ============================================================
pairedL   = false
pairedLPB = 0
pairedLPV = 0.0
pairedLRB = 0
pairedLRV = 0.0

if not na(newPricePLBar) and not na(newHistPLBar)
    pairedL := true
    pairedLPB := newPricePLBar
    pairedLPV := newPricePLVal
    pairedLRB := newHistPLBar
    pairedLRV := newHistPLVal

if not pairedL and not na(newPricePLBar) and not na(waitHistPLBar) and math.abs(newPricePLBar - waitHistPLBar) <= matchTolerance
    pairedL := true
    pairedLPB := newPricePLBar
    pairedLPV := newPricePLVal
    pairedLRB := waitHistPLBar
    pairedLRV := waitHistPLVal

if not pairedL and not na(newHistPLBar) and not na(waitPricePLBar) and math.abs(newHistPLBar - waitPricePLBar) <= matchTolerance
    pairedL := true
    pairedLPB := waitPricePLBar
    pairedLPV := waitPricePLVal
    pairedLRB := newHistPLBar
    pairedLRV := newHistPLVal

if pairedL
    if not na(tPLLineHist)
        line.delete(tPLLineHist)
        tPLLineHist := na
    if not na(tPLLinePrice)
        line.delete(tPLLinePrice)
        tPLLinePrice := na
    tWaitPricePLBar := na
    tWaitPricePLVal := na
    tWaitHistPLBar   := na
    tWaitHistPLVal   := na
    prevPLPriceBar := currPLPriceBar
    prevPLPriceVal := currPLPriceVal
    prevPLHistBar   := currPLHistBar
    prevPLHistVal   := currPLHistVal
    currPLPriceBar := pairedLPB
    currPLPriceVal := pairedLPV
    currPLHistBar   := pairedLRB
    currPLHistVal   := pairedLRV
    waitPricePLBar := na
    waitPricePLVal := na
    waitHistPLBar   := na
    waitHistPLVal   := na
    if not na(prevPLPriceVal)
        gapL = currPLPriceBar - prevPLPriceBar
        if gapL >= rangeMin and gapL <= rangeMax
            priceDeltaL = math.abs(currPLPriceVal - prevPLPriceVal)
            histDeltaL   = math.abs(currPLHistVal   - prevPLHistVal)
            qualityOkL  = priceDeltaL >= atrVal * minPriceAtrMult or histDeltaL >= histStd * minHistSigmaMult
            float priceMinInterior = na
            float histMinInterior   = na
            if currPLPriceBar - prevPLPriceBar > 1
                for i = 1 to 500
                    int checkBar = prevPLPriceBar + i
                    if checkBar >= currPLPriceBar
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float pv = low[offset]
                        if na(priceMinInterior) or pv < priceMinInterior
                            priceMinInterior := pv
            if currPLHistBar - prevPLHistBar > 1
                for i = 1 to 500
                    int checkBar = prevPLHistBar + i
                    if checkBar >= currPLHistBar
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float rv = hist[offset]
                        if na(histMinInterior) or rv < histMinInterior
                            histMinInterior := rv
            priceExcessL = atrVal * pathPriceAtrMult
            // Regular bullish: reference LL = currPL price, reference HL = prevPL hist
            if currPLPriceVal < prevPLPriceVal and currPLHistVal > prevPLHistVal and qualityOkL
                pathOkRegBullL = (na(priceMinInterior) or priceMinInterior >= currPLPriceVal - priceExcessL) and (na(histMinInterior) or histMinInterior >= prevPLHistVal - histExcess)
                if pathOkRegBullL
                    regBull := true
                    if showRegBull
                        line.new(prevPLHistBar, prevPLHistVal, currPLHistBar, currPLHistVal,
                                 color=color.green, width=2)
                        line.new(prevPLPriceBar, prevPLPriceVal, currPLPriceBar, currPLPriceVal,
                                 color=color.green, width=2, force_overlay=true)
            // Hidden bullish: reference HL = currPL price, reference LL = currPL hist
            if currPLPriceVal > prevPLPriceVal and currPLHistVal < prevPLHistVal and qualityOkL
                pathOkHidBullL = (na(priceMinInterior) or priceMinInterior >= prevPLPriceVal - priceExcessL) and (na(histMinInterior) or histMinInterior >= currPLHistVal - histExcess)
                if pathOkHidBullL
                    hidBull := true
                    if showHidBull
                        line.new(prevPLHistBar, prevPLHistVal, currPLHistBar, currPLHistVal,
                                 color=color.aqua, width=2)
                        line.new(prevPLPriceBar, prevPLPriceVal, currPLPriceBar, currPLPriceVal,
                                 color=color.aqua, width=2, force_overlay=true)
else
    if not na(newPricePLBar)
        waitPricePLBar := newPricePLBar
        waitPricePLVal := newPricePLVal
    if not na(newHistPLBar)
        waitHistPLBar := newHistPLBar
        waitHistPLVal := newHistPLVal

// ============================================================
// TENTATIVE HIGHS
// ============================================================
tPairedH   = false
tPairedHPB = 0
tPairedHPV = 0.0
tPairedHRB = 0
tPairedHRV = 0.0

if not na(tNewPricePHBar) and not na(tNewHistPHBar)
    tPairedH := true
    tPairedHPB := tNewPricePHBar
    tPairedHPV := tNewPricePHVal
    tPairedHRB := tNewHistPHBar
    tPairedHRV := tNewHistPHVal

if not tPairedH and not na(tNewPricePHBar) and not na(tWaitHistPHBar) and math.abs(tNewPricePHBar - tWaitHistPHBar) <= matchTolerance
    tPairedH := true
    tPairedHPB := tNewPricePHBar
    tPairedHPV := tNewPricePHVal
    tPairedHRB := tWaitHistPHBar
    tPairedHRV := tWaitHistPHVal

if not tPairedH and not na(tNewHistPHBar) and not na(tWaitPricePHBar) and math.abs(tNewHistPHBar - tWaitPricePHBar) <= matchTolerance
    tPairedH := true
    tPairedHPB := tWaitPricePHBar
    tPairedHPV := tWaitPricePHVal
    tPairedHRB := tNewHistPHBar
    tPairedHRV := tNewHistPHVal

if (not na(tNewPricePHBar) or not na(tNewHistPHBar))
    if not na(tPHLineHist)
        line.delete(tPHLineHist)
        tPHLineHist := na
    if not na(tPHLinePrice)
        line.delete(tPHLinePrice)
        tPHLinePrice := na

if tPairedH
    tWaitPricePHBar := na
    tWaitPricePHVal := na
    tWaitHistPHBar   := na
    tWaitHistPHVal   := na
    if not na(currPHPriceVal)
        tGapH = tPairedHPB - currPHPriceBar
        if tGapH >= rangeMin and tGapH <= rangeMax
            tPriceDeltaH = math.abs(tPairedHPV - currPHPriceVal)
            tHistDeltaH   = math.abs(tPairedHRV - currPHHistVal)
            tQualityOkH  = tPriceDeltaH >= atrVal * minPriceAtrMult or tHistDeltaH >= histStd * minHistSigmaMult
            float tPriceMaxInterior = na
            float tHistMaxInterior   = na
            if tPairedHPB - currPHPriceBar > 1
                for i = 1 to 500
                    int checkBar = currPHPriceBar + i
                    if checkBar >= tPairedHPB
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float pv = high[offset]
                        if na(tPriceMaxInterior) or pv > tPriceMaxInterior
                            tPriceMaxInterior := pv
            if tPairedHRB - currPHHistBar > 1
                for i = 1 to 500
                    int checkBar = currPHHistBar + i
                    if checkBar >= tPairedHRB
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float rv = hist[offset]
                        if na(tHistMaxInterior) or rv > tHistMaxInterior
                            tHistMaxInterior := rv
            tPriceExcess = atrVal * pathPriceAtrMult
            // Tentative regular bearish: reference HH = tentative price, reference LH = currPH hist
            if tPairedHPV > currPHPriceVal and tPairedHRV < currPHHistVal and tQualityOkH
                tPathOkRegBearH = (na(tPriceMaxInterior) or tPriceMaxInterior <= tPairedHPV + tPriceExcess) and (na(tHistMaxInterior) or tHistMaxInterior <= currPHHistVal + histExcess)
                if tPathOkRegBearH
                    tRegBear := true
                    if showRegBear
                        tPHLineHist := line.new(currPHHistBar, currPHHistVal, tPairedHRB, tPairedHRV,
                                               color=color.red, width=2, style=line.style_dashed)
                        tPHLinePrice := line.new(currPHPriceBar, currPHPriceVal, tPairedHPB, tPairedHPV,
                                                 color=color.red, width=2, style=line.style_dashed, force_overlay=true)
            // Tentative hidden bearish: reference LH = currPH price, reference HH = tentative hist
            if tPairedHPV < currPHPriceVal and tPairedHRV > currPHHistVal and tQualityOkH
                tPathOkHidBearH = (na(tPriceMaxInterior) or tPriceMaxInterior <= currPHPriceVal + tPriceExcess) and (na(tHistMaxInterior) or tHistMaxInterior <= tPairedHRV + histExcess)
                if tPathOkHidBearH
                    tHidBear := true
                    if showHidBear
                        tPHLineHist := line.new(currPHHistBar, currPHHistVal, tPairedHRB, tPairedHRV,
                                               color=color.orange, width=2, style=line.style_dashed)
                        tPHLinePrice := line.new(currPHPriceBar, currPHPriceVal, tPairedHPB, tPairedHPV,
                                                 color=color.orange, width=2, style=line.style_dashed, force_overlay=true)
else
    if not na(tNewPricePHBar)
        tWaitPricePHBar := tNewPricePHBar
        tWaitPricePHVal := tNewPricePHVal
    if not na(tNewHistPHBar)
        tWaitHistPHBar := tNewHistPHBar
        tWaitHistPHVal := tNewHistPHVal

// ============================================================
// TENTATIVE LOWS
// ============================================================
tPairedL   = false
tPairedLPB = 0
tPairedLPV = 0.0
tPairedLRB = 0
tPairedLRV = 0.0

if not na(tNewPricePLBar) and not na(tNewHistPLBar)
    tPairedL := true
    tPairedLPB := tNewPricePLBar
    tPairedLPV := tNewPricePLVal
    tPairedLRB := tNewHistPLBar
    tPairedLRV := tNewHistPLVal

if not tPairedL and not na(tNewPricePLBar) and not na(tWaitHistPLBar) and math.abs(tNewPricePLBar - tWaitHistPLBar) <= matchTolerance
    tPairedL := true
    tPairedLPB := tNewPricePLBar
    tPairedLPV := tNewPricePLVal
    tPairedLRB := tWaitHistPLBar
    tPairedLRV := tWaitHistPLVal

if not tPairedL and not na(tNewHistPLBar) and not na(tWaitPricePLBar) and math.abs(tNewHistPLBar - tWaitPricePLBar) <= matchTolerance
    tPairedL := true
    tPairedLPB := tWaitPricePLBar
    tPairedLPV := tWaitPricePLVal
    tPairedLRB := tNewHistPLBar
    tPairedLRV := tNewHistPLVal

if (not na(tNewPricePLBar) or not na(tNewHistPLBar))
    if not na(tPLLineHist)
        line.delete(tPLLineHist)
        tPLLineHist := na
    if not na(tPLLinePrice)
        line.delete(tPLLinePrice)
        tPLLinePrice := na

if tPairedL
    tWaitPricePLBar := na
    tWaitPricePLVal := na
    tWaitHistPLBar   := na
    tWaitHistPLVal   := na
    if not na(currPLPriceVal)
        tGapL = tPairedLPB - currPLPriceBar
        if tGapL >= rangeMin and tGapL <= rangeMax
            tPriceDeltaL = math.abs(tPairedLPV - currPLPriceVal)
            tHistDeltaL   = math.abs(tPairedLRV - currPLHistVal)
            tQualityOkL  = tPriceDeltaL >= atrVal * minPriceAtrMult or tHistDeltaL >= histStd * minHistSigmaMult
            float tPriceMinInterior = na
            float tHistMinInterior   = na
            if tPairedLPB - currPLPriceBar > 1
                for i = 1 to 500
                    int checkBar = currPLPriceBar + i
                    if checkBar >= tPairedLPB
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float pv = low[offset]
                        if na(tPriceMinInterior) or pv < tPriceMinInterior
                            tPriceMinInterior := pv
            if tPairedLRB - currPLHistBar > 1
                for i = 1 to 500
                    int checkBar = currPLHistBar + i
                    if checkBar >= tPairedLRB
                        break
                    int offset = bar_index - checkBar
                    if offset >= 0
                        float rv = hist[offset]
                        if na(tHistMinInterior) or rv < tHistMinInterior
                            tHistMinInterior := rv
            tPriceExcessL = atrVal * pathPriceAtrMult
            // Tentative regular bullish: reference LL = tentative price, reference HL = currPL hist
            if tPairedLPV < currPLPriceVal and tPairedLRV > currPLHistVal and tQualityOkL
                tPathOkRegBullL = (na(tPriceMinInterior) or tPriceMinInterior >= tPairedLPV - tPriceExcessL) and (na(tHistMinInterior) or tHistMinInterior >= currPLHistVal - histExcess)
                if tPathOkRegBullL
                    tRegBull := true
                    if showRegBull
                        tPLLineHist := line.new(currPLHistBar, currPLHistVal, tPairedLRB, tPairedLRV,
                                               color=color.green, width=2, style=line.style_dashed)
                        tPLLinePrice := line.new(currPLPriceBar, currPLPriceVal, tPairedLPB, tPairedLPV,
                                                 color=color.green, width=2, style=line.style_dashed, force_overlay=true)
            // Tentative hidden bullish: reference HL = currPL price, reference LL = tentative hist
            if tPairedLPV > currPLPriceVal and tPairedLRV < currPLHistVal and tQualityOkL
                tPathOkHidBullL = (na(tPriceMinInterior) or tPriceMinInterior >= currPLPriceVal - tPriceExcessL) and (na(tHistMinInterior) or tHistMinInterior >= tPairedLRV - histExcess)
                if tPathOkHidBullL
                    tHidBull := true
                    if showHidBull
                        tPLLineHist := line.new(currPLHistBar, currPLHistVal, tPairedLRB, tPairedLRV,
                                               color=color.aqua, width=2, style=line.style_dashed)
                        tPLLinePrice := line.new(currPLPriceBar, currPLPriceVal, tPairedLPB, tPairedLPV,
                                                 color=color.aqua, width=2, style=line.style_dashed, force_overlay=true)
else
    if not na(tNewPricePLBar)
        tWaitPricePLBar := tNewPricePLBar
        tWaitPricePLVal := tNewPricePLVal
    if not na(tNewHistPLBar)
        tWaitHistPLBar := tNewHistPLBar
        tWaitHistPLVal := tNewHistPLVal

// ============================================================
// Alerts
// ============================================================
alertcondition(regBull  and showRegBull, "MACD-hist Regular Bullish Divergence",
               "MACD-hist Regular Bullish Divergence on {{ticker}} {{interval}}")
alertcondition(regBear  and showRegBear, "MACD-hist Regular Bearish Divergence",
               "MACD-hist Regular Bearish Divergence on {{ticker}} {{interval}}")
alertcondition(hidBull  and showHidBull, "MACD-hist Hidden Bullish Divergence",
               "MACD-hist Hidden Bullish Divergence on {{ticker}} {{interval}}")
alertcondition(hidBear  and showHidBear, "MACD-hist Hidden Bearish Divergence",
               "MACD-hist Hidden Bearish Divergence on {{ticker}} {{interval}}")
alertcondition(tRegBull and showRegBull, "MACD-hist Tentative Regular Bullish Divergence",
               "Tentative MACD-hist Regular Bullish Divergence on {{ticker}} {{interval}}")
alertcondition(tRegBear and showRegBear, "MACD-hist Tentative Regular Bearish Divergence",
               "Tentative MACD-hist Regular Bearish Divergence on {{ticker}} {{interval}}")
alertcondition(tHidBull and showHidBull, "MACD-hist Tentative Hidden Bullish Divergence",
               "Tentative MACD-hist Hidden Bullish Divergence on {{ticker}} {{interval}}")
alertcondition(tHidBear and showHidBear, "MACD-hist Tentative Hidden Bearish Divergence",
               "Tentative MACD-hist Hidden Bearish Divergence on {{ticker}} {{interval}}")
